#!/usr/bin/env bash
set -euo pipefail
root="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [[ ! -x "$root/target/release/basalt-wrap" ]]; then
    echo "Build the Rust wrapper first: cargo build --release --manifest-path $root/Cargo.toml" >&2
    exit 1
fi
exec "$root/target/release/basalt-wrap" "$@"
